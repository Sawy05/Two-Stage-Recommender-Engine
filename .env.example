# Service & Runtime Configuration
APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
DEVICE=auto
MODEL_CONFIG_PATH=configs/model_config.yaml

# Stage 1: Vector Database (Qdrant / Milvus)
VECTOR_DB_BACKEND=qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=items_two_tower
MILVUS_HOST=localhost
MILVUS_PORT=19530
HNSW_M=16
HNSW_EF_CONSTRUCT=128
HNSW_EF_SEARCH=64

# Caching Layer (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_USER_VECTOR_TTL_SECONDS=3600

# Stage 2: DCNv2 Ranking & Exported Artifacts
TWO_TOWER_CHECKPOINT_PATH=checkpoints/two_tower.pt
DCNV2_CHECKPOINT_PATH=checkpoints/dcn_v2.pt
DCNV2_TORCHSCRIPT_PATH=checkpoints/dcn_v2_scripted.pt
DCNV2_ONNX_PATH=checkpoints/dcn_v2.onnx

# Contextual Bandit (Cold-Start Exploration)
EXPLORATION_TRAFFIC_SLICE=0.05
LINUCB_ALPHA=1.25
